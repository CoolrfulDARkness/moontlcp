name = "CoolrfulDARkness/moontlcp"

version = "0.3.0"

readme = "README.mbt.md"

repository = "https://github.com/CoolrfulDARkness/moontlcp"

license = "Apache-2.0"

keywords = [
  "tlcp",
  "sm9",
  "gm",
  "sm2",
  "sm3",
  "sm4",
  "ibe",
  "bn256",
  "crypto",
  "tls",
  "security",
  "gmt0024",
  "gbt38635",
  "x509",
]

preferred_target = "wasm"

description = "Pure MoonBit, zero-FFI, unified Chinese national standard cryptography stack: Sans-I/O GM/T 0024-2023 (TLCP 1.1) dual-certificate protocol + GB/T 38635-2020 SM9 BN256 identity-based cryptography over a shared SM3/SM4/CT core."
