name = "CoolrfulDARkness/moontlcp"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/CoolrfulDARkness/moontlcp"

license = "Apache-2.0"

keywords = [
  "tlcp",
  "gm",
  "sm2",
  "sm3",
  "sm4",
  "crypto",
  "tls",
  "security",
  "gmt0024",
  "x509",
]

preferred_target = "wasm"

description = "Pure MoonBit, zero-FFI, type-safe Sans-I/O GM/T 0024-2023 (TLCP 1.1) dual-certificate Transport Layer Cryptography Protocol stack with full SM2/SM3/SM4 primitives and X.509 dual-certificate validation."
