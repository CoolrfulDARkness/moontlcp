// Auto-generated by harness/interop_openssl.py using OpenSSL 3.5.6 7 Apr 2026 (Library: OpenSSL 3.5.6 7 Apr 2026).
// Verifies MoonTLCP against live OpenSSL 3.5.6 SM3/SM4/SM2/X.509 dual-cert outputs.

///|
fn hex_nibble(c : Int32) -> Int32 {
  if c >= 0x30 && c <= 0x39 {
    c - 0x30
  } else if c >= 0x61 && c <= 0x66 {
    c - 0x61 + 10
  } else if c >= 0x41 && c <= 0x46 {
    c - 0x41 + 10
  } else {
    abort("invalid hex char")
  }
}

///|
fn from_hex(s : String) -> Bytes {
  let n = s.length() / 2
  let out = FixedArray::make(n, b'\x00')
  for i = 0; i < n; i = i + 1 {
    let hi = hex_nibble(s[i * 2].to_int())
    let lo = hex_nibble(s[i * 2 + 1].to_int())
    out[i] = ((hi << 4) | lo).to_byte()
  }
  Bytes::from_array(out)
}

///|
test "OpenSSL 3.5.6 -> MoonTLCP: SM3 digest matches live OpenSSL output" {
  let msg = from_hex(
    "4f70656e53534c20332e352e36206c69766520534d3320766563746f72202d3e" +
    "204d6f6f6e544c43503a20613430343334323030303433373334666261383561" +
    "3534353734666266653264",
  )
  let expected = from_hex(
    "38040cfec5aa0a5e1992115a760ba5c6d38355ab3c6b735a1235dc36d0b4a66b",
  )
  assert_eq(@sm3.sm3(msg), expected)
}

///|
test "OpenSSL 3.5.6 -> MoonTLCP: SM4-CBC-PKCS7 & SM4-CTR match live OpenSSL output" {
  let key = from_hex("354453309e57c8ab92592ff5b16ae35f")
  let iv = from_hex("e51783be976c28947093c5432847b9c0")
  let pt = from_hex(
    "4f70656e53534c20332e352e36206c69766520534d34207061796c6f61642028" +
    "6e6f6e2d626c6f636b2d616c69676e65642035334229",
  )
  let cbc_ct = from_hex(
    "84680e3a47bece228b32a9506dfbeb479608b2bc1b45c9bc83ded2fd67e873fb" +
    "9a0f86e3aa83aedb7ee7faa4ac7362c0f38f9aaad00d40b9ba6d83b5b1ada4b7",
  )
  let ctr_ct = from_hex(
    "cf657c24f2da035e0d043e249bd9461d12e61ef673fea91a5eb9daf9b60657d0" +
    "5e824b5256d36004425a161d12508783a7891b9364b7",
  )
  let sm4 = @sm4.Sm4Key::new(key)
  assert_eq(sm4.cbc_encrypt_pkcs7(iv, pt), cbc_ct)
  assert_eq(sm4.cbc_decrypt_pkcs7(iv, cbc_ct), pt)
  assert_eq(sm4.ctr_crypt(iv, pt), ctr_ct)
  assert_eq(sm4.ctr_crypt(iv, ctr_ct), pt)
}

///|
test "OpenSSL 3.5.6 -> MoonTLCP: SM2 DER signature verify & ASN.1 SM2Cipher decrypt" {
  let priv_key = @sm2.PrivateKey::from_bytes(
    from_hex("ead68acaef15ee7c082e9e0aedb98c7f1f5ef238783d1982f1138e1bfc96f26b"),
  )
  let pub_key = @sm2.PublicKey::from_bytes(
    from_hex(
      "0487fcdec5e956c7ee30ffcd4163b7fbbb26d923ad9cd3f36e521153a1520ee2" +
      "ce421d0406e9f056cea0f65283acca68321b8b5229ac5f7af86c5ca4a4bdc2a0" +
      "66",
    ),
  )
  assert_eq(priv_key.public_key(), pub_key)

  let msg = from_hex(
    "4f70656e53534c20332e352e36206c69766520534d32207369676e2f656e6372" +
    "79707420766563746f7220666f72204d6f6f6e544c4350",
  )
  let sig_der = from_hex(
    "3045022100ca8b66dae98417fb57f30e196836169b06bbfff8ff19c9343409e2" +
    "6dead3139a02203a7cc3bba788475c6779ca62e904252245570b383e7c5150a3" +
    "7ff5f35f29df23",
  )
  let cipher_asn1 = from_hex(
    "3081a00220336ebb52f789c480511a3c770ecf91eefd3a584031f0a240879212" +
    "91bd1dff8c022100e545fde86dfc8cc015acd6ae59c6bdfdbac8dca3f2fc70ce" +
    "c056842628322c290420e2af628838f5c6fbbebed44a9c57aa335a5c502715cc" +
    "ad5381a4ee66ecab993d043768c721586611000df810ecfeb5ac693cda0f5177" +
    "d47fc843631a31700b28ac0a4348bd221d5ff685ab9a6a508870f01571bf11be" +
    "d4b346",
  )
  assert_true(@sm2.verify_der(pub_key, @sm2.DEFAULT_SM2_ID, msg, sig_der))
  assert_eq(@sm2.decrypt_asn1(priv_key, cipher_asn1), msg)
}

